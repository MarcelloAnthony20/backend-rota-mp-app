# .env.example — modelo de configuracao do backend.
# Copie para .env e ajuste os valores:  cp .env.example .env
# O .env real NAO deve ser commitado (ja esta no .gitignore).
#
# Uso local (Maven):   set -a && source .env && set +a && mvn spring-boot:run
# Uso Docker:          docker run -p 8080:8080 --env-file .env rota-mp-app:1.0.0

# --- Banco de dados (PostgreSQL) ---
# DB_URL/DB_USERNAME/DB_PASSWORD devem bater com o Postgres alvo.
# No Docker Desktop, para alcancar o Postgres do host, troque "localhost" por "host.docker.internal".
DB_URL=jdbc:postgresql://localhost:5432/rotamp
DB_USERNAME=seu_usuario_banco
DB_PASSWORD=sua_senha_banco
DB_SCHEMA=public

# Variaveis para o docker-compose.yml local (subir container PostgreSQL):
POSTGRES_DB=rotamp
POSTGRES_USER=rotamp_user
POSTGRES_PASSWORD=sua_senha_forte_aqui
POSTGRES_PORT=5432

# Estrategia de schema do Hibernate:
# - dev com banco vazio: use "update" para o Hibernate criar as tabelas.
# - HML/PROD: mantenha "validate" (o schema deve existir previamente via Flyway).
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# --- Keycloak (OAuth2 Resource Server) ---
# Em homologacao/producao aponte para o realm institucional correspondente
KEYCLOAK_ISSUER_URI=https://keycloak.mpms.mp.br/realms/seu_realm
KEYCLOAK_JWKS_URI=https://keycloak.mpms.mp.br/realms/seu_realm/protocol/openid-connect/certs

# --- Armazenamento de Fotos (Microsoft Azure Blob Storage / Emulador Azurite) ---
# Para desenvolvimento com Azurite local (veja docker-compose.yml):
# AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
# Para Azure Blob Storage em nuvem:
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=sua_conta;AccountKey=sua_chave;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_STORAGE_CONTAINER_NAME=fotos-veiculos

# --- Servidor / Service Discovery (Eureka) ---
SERVER_PORT=8080
EUREKA_URL=http://localhost:8761/eureka
# Em dev sem Eureka local, desabilite para evitar ruido de conexao:
EUREKA_CLIENT_ENABLED=false
SPRING_CLOUD_DISCOVERY_ENABLED=false

# --- Artifactory (necessario apenas para o BUILD com Maven / docker build) ---
# Preencha seu usuario e token institucional apenas no seu arquivo .env local ou ~/.m2/settings.xml
ARTIFACTORY_URL=https://artifactory.mpms.mp.br/artifactory
ARTIFACTORY_USER=seu.usuario
ARTIFACTORY_PASSWORD=seu-token-gerado-gerado
